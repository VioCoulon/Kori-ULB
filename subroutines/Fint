function [F1, F2] = F_int_all(visc, H, zeta)
    
    % Preallocate arrays
    %F_1 = zeros(n, n_z);
    %F_2 = zeros(n, 1);
    %F_all = zeros(n, n_z + 1);

    F1 = zeros([ctr.imax, ctr.jmax, ctr.kmax]);
    F2 = zeros([ctr.imax, ctr.jmax, ctr.kmax]);
    dz_H = zeros([ctr.imax, ctr.jmax, ctr.kmax]);

    n_2 = 2;

    % Horizontal loop
    %z = 0;
    sum_1 = zeros(n, n_z);
    sum_2 = zeros(n, n_z);

    % Differences in vertical dimension.
    dz = zeros([ctr.kmax, 1]);
    dz(2:ctr.kmax) = diff(zeta);
    dz(1) = dz(2);

    

    % Vertical integration
    for k = 1:ctr.kmax

        
        dz_H(:,:,k) = dz(k) * H;


        H_minus_z = (H - z) / H;

        value_2 = H_minus_z .^ n_2 / visc(:,:,k);
        sum_2 = sum_2 + value_2 * dz_H(k);
        %F_2(:,:,k) = sum_2;

        value_1 = H_minus_z / visc(i,j,k);
        sum_1 = sum_1 + value_1;
        F_1(:,:,k) = sum_1;

        %z = z + dz(i);
        %z = z + zeta(k) * H;
        
    end

    % Scale by dz
    %F_1(i, :) = dz_H(i) * F_1(i, :);
    %F_2(i) = dz(i) * sum_2;

    F1 = dz_H .* F1;
    F2 = sum_2;

    % Concatenate F_2 as the first column
    %F_all = [F_2, F_1];
end